# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，不要提交
# SECRET_KEY 生产请用：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-secret-key-0123456789abcdef0123456789abcdef
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 与仓库根目录 docker-compose.yml 的本地开发默认值一致
DATABASE_URL=postgresql+psycopg://postgres:mysecretpassword@localhost:5432/mydb

# 种子账号（可选覆盖）
ADMIN_EMAIL=admin@example.com
MEMBER_EMAIL=staff@example.com
DEFAULT_PASSWORD=ChangeMe123!

# 阶段 2：文档摄取
# STORAGE_DIR 相对 backend/ 目录解释；生产请改为挂载卷的绝对路径
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_BYTES=20971520
CHUNK_SIZE=800
CHUNK_OVERLAP=80

# 阶段 3：Embedding 与向量索引
# EMBEDDING_PROVIDER=mock：离线确定性向量，便于开发与测试；
# EMBEDDING_PROVIDER=openai：调用 OpenAI 兼容 /embeddings（需要 API Key）。
# 两者输出维度都必须等于 EMBEDDING_DIM；更换维度需要新建迁移并重建索引。
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30

# 阶段 4：检索与混合排序
VECTOR_TOP_K=10
KEYWORD_TOP_K=10
RRF_K=60
ANSWER_CONTEXT_TOP_K=4

# 阶段 6：回答模型
# LLM_PROVIDER=mock：不调用外部模型，直接走提取式降级（离线演示可用）；
# LLM_PROVIDER=openai：调用 OpenAI 兼容 /chat/completions（需要 API Key）。
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
STRICT_ANSWER_REFUSAL=true
EXTRACTIVE_FALLBACK_ENABLED=true

# 阶段 7：前端静态目录与跨域
FRONTEND_DIR=../frontend
CORS_ORIGINS=*